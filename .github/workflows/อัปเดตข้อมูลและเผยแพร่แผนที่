name: อัปเดตข้อมูลและเผยแพร่แผนที่

on:
  schedule:
    - cron: "*/30 * * * *"   # ทุก 30 นาที
  workflow_dispatch:          # กดรันเองได้จากแท็บ Actions
  push:
    branches: [main]
    paths-ignore: ["kanchanaburi-flood-map/data/**"]

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: flood-map
  cancel-in-progress: false

env:
  APP_DIR: kanchanaburi-flood-map   # โฟลเดอร์ที่เก็บ index.html, scripts, data

jobs:
  update:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: ดึงข้อมูล
        working-directory: ${{ env.APP_DIR }}
        env:
          GISTDA_API_KEY: ${{ secrets.GISTDA_API_KEY }}
          GISTDA_PERIODS: ${{ vars.GISTDA_PERIODS || '1day,3days,7days' }}
          THAIWATER_DAM_PATHS: ${{ vars.THAIWATER_DAM_PATHS || 'analyst/dam,public/dam_load' }}
        run: python scripts/fetch_data.py

      - name: บันทึกข้อมูลกลับเข้า repo
        run: |
          git config user.name "flood-map-bot"
          git config user.email "flood-map-bot@users.noreply.github.com"
          git add "$APP_DIR/data/"
          git diff --cached --quiet || git commit -m "data: $(TZ=Asia/Bangkok date '+%Y-%m-%d %H:%M')"
          git pull --rebase --autostash || true
          git push || echo "push ไม่สำเร็จ รอบหน้าจะลองใหม่"

      - uses: actions/configure-pages@v5

      - uses: actions/upload-pages-artifact@v3
        with:
          path: ${{ env.APP_DIR }}

      - id: deploy
        uses: actions/deploy-pages@v4
